# Copy to .env for local tooling (migrations). On Vercel, set these in
# Project Settings → Environment Variables instead — never commit real values.

# Supabase Transaction pooler (port 6543) — used by the app at runtime.
# If your DB password contains special characters (@ : / ?), percent-encode
# them (e.g. "@" -> "%40").
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct connection (port 5432) — used only for migrations.
# Note: on newer Supabase projects this host is IPv6-only unless you add the
# IPv4 add-on. Migrations here are run via the Supabase SQL Editor instead, so
# this is optional.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Added in later phases (not needed for Phase 1) ---
# ANTHROPIC_API_KEY=          # Phase 2: fit scoring / JD parsing / drafting
# GMAIL_OAUTH_CLIENT_ID=      # Phase 2: Gmail alert parser
# GMAIL_OAUTH_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=       # Phase 2: encrypt Gmail tokens at rest
# CRON_SECRET=                # Phase 2: protect scheduled endpoints
